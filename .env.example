# انسخ هذا الملف إلى .env.local (محلياً) أو أضف القيم في إعدادات Vercel → Environment Variables

# الدومين النهائي
NEXT_PUBLIC_SITE_URL=https://tech.warrdly.com

# ---------------------------------------------------------------
# الخيار (أ): إنشاء الفرصة مباشرة في Odoo CRM عبر الـAPI
# يتطلب أن تكون باقة Odoo Online تسمح بالـAPI الخارجي
# مفتاح API: من Odoo → My Profile → Account Security → New API Key
# ---------------------------------------------------------------
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your-company
ODOO_LOGIN=website@warrdly.com
ODOO_API_KEY=
# اختياري: رقم فريق المبيعات في CRM
ODOO_TEAM_ID=

# ---------------------------------------------------------------
# الخيار (ب): إرسال الطلب بالبريد إلى عنوان فريق المبيعات في Odoo
# (CRM → Configuration → Sales Teams → Email Alias) — يعمل على كل الباقات
# يُستخدم تلقائياً إذا كان الخيار (أ) غير مُعدّ
# ---------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEAD_TO_EMAIL=sales@your-company.odoo.com

# Cloudflare Web Analytics (optional): token from Cloudflare → Analytics & Logs → Web Analytics
NEXT_PUBLIC_CF_BEACON_TOKEN=
